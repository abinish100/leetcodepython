class Solution(object):
    def isPrefixString(self, s, words):
        if words[0] == s[0:len(words[0])]:
            l=len(words)
            s1=s[len(words[0]):]+" "
            for i in range(1,l):
                if words[i]==s1[:len(words[i])]:
                    s1=s1[len(words[i]):]
                else:
                    break
            if s1==" ":
                return True
            return False
        else:
            return False



            
        
