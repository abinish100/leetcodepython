class Solution(object):
    def slowestKey(self, releaseTimes, keysPressed):
        ma= releaseTimes[0]
        v= keysPressed[0]

        for i in range(1, len(releaseTimes)):
            v1= releaseTimes[i] - releaseTimes[i-1]
            if v1 > ma or (v1 == ma and keysPressed[i] > v):
                ma = v1
                v = keysPressed[i]

        return v

        
