class Solution(object):
    def truncateSentence(self, s, k):
        s1=""
        for i in range(len(s)):
        
            if s[i]==" ":
                k=k-1
                if k==0:
                    break
                s1=s1+s[i]
            else:
                s1=s1+s[i]
        return s1
