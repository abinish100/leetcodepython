class Solution(object):
    def countQuadruplets(self, nums):
        l=len(nums)
        c=0
        for i in range(l):
            for j in range(i+1,l):
                for k in range(j+1,l):
                    for e in range(k+1,l):
                        if nums[i]+nums[j]+nums[k] == nums[e]:
                            c+=1
        return c
