class Solution(object):
    def countHillValley(self, nums):
        s=[nums[0]]
        c=0
        for i in nums:
            if i !=s[-1]:
                s.append(i)
        for j in range(1,len(s)-1):
            if s[j-1]<s[j] and s[j+1]<s[j] or s[j-1]>s[j] and s[j+1]>s[j]:
                c+=1
        return c
