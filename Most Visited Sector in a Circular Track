class Solution(object):
    def mostVisited(self, n, rounds):
        a1 = []
        a2 = []
        a3 = []
        for i in range(1, n+1):
            a1.append(i)
            a2.append(0)
        for i in range(1, len(rounds)):
            start = rounds[i-1]
            end = rounds[i]
            while start != end:
                a2[start-1] += 1
                start = (start % n) + 1
        a2[rounds[-1]-1] += 1
        
        m = max(a2)
        for k in range(len(a2)):
            if a2[k] == m:
                a3.append(a1[k])
        return a3
