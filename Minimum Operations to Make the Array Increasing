class Solution(object):
    def minOperations(self, nums):
        s=0
        l=len(nums)
        if l<=1:
            return 0
        else:
            for i in range(1,l):
                if nums[i-1]>=nums[i]:
                    v=nums[i-1]-nums[i]+1
                    nums[i]=v+nums[i]
                    s=s+v
            return s
