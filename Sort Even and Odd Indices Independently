class Solution(object):
    def sortEvenOdd(self, nums):
        a1=[]
        a2=[]
        l=len(nums)
        for i in range(l):
            if i%2==0:
                a1.append(nums[i])
            else:
                a2.append(nums[i])
        a1=sorted(a1)
        a2=sorted(a2)
        a2=a2[::-1]
        i1=0
        i2=0
        for i in range(l):
            if i%2==0:
                nums[i]=a1[i1]
                i1+=1
            else:
                nums[i]=a2[i2]
                i2+=1
        return nums
