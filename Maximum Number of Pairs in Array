class Solution(object):
    def numberOfPairs(self, nums):
        a=[]
        p=0
        n=0
        s=sorted(nums)
        if len(nums)==1:
            return [0,1]
        for i in range(len(nums)-1):
            if s[i]==s[i+1]:
                s[i+1]="s"
                p+=1
            elif s[i]!="s":
                n+=1
        if s[-1]!="s":
            n+=1
        return [p,n]
