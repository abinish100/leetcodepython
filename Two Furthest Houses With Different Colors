class Solution(object):
    def maxDistance(self, colors):
        l = len(colors)
        for j in range(l-1, -1, -1):
            if colors[0] != colors[j]:
                v1 = j
                break
        for i in range(l):
            if colors[l-1] != colors[i]:
                v2 = l-1 - i
                break
        
        return max(v1, v2)
